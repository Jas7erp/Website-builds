# Publiek https-adres van het boekingsportaal (nodig voor betaal-redirects, Mollie-webhooks en e-maillinks)
PUBLIC_URL=https://afspraak.jouwsalon.nl
PORT=3000
NODE_ENV=production

# Verplicht in productie: lang willekeurig geheim (min. 32 tekens). Versleutelt o.a. API-sleutels en wachtwoorden in de database.
# Genereer met: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# Zet op 1 als de app achter een reverse proxy (nginx, Caddy, Render, Fly.io) draait
TRUST_PROXY=1

# Optioneel: locatie van de SQLite-database (standaard ./data/salon.db)
# DATABASE_PATH=/var/lib/salon/salon.db
# SALON_TIMEZONE=Europe/Amsterdam

# Optioneel: eerste eigenaarsaccount bij de eerste start (verwijder het wachtwoord daarna)
# ADMIN_EMAIL=eigenaar@jouwsalon.nl
# ADMIN_PASSWORD=

# Optioneel: standaardwaarden voor integraties. Alles kan ook in /admin → Instellingen worden ingesteld.
# MOLLIE_API_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.jouwprovider.nl
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Studio Lumen" <afspraken@jouwsalon.nl>
